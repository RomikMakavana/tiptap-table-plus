{
    "compilerOptions": {
      "target": "ES6",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "outDir": "./dist",
      "declaration": true,
      "emitDeclarationOnly": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
  }
